# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# LangSmith tracing toggle; enable in https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true

# LangSmith API key from https://smith.langchain.com/
LANGCHAIN_API_KEY=your_langsmith_api_key_here

# LangSmith project name; create or select one in https://smith.langchain.com/
LANGCHAIN_PROJECT=ai-travel-planner

# Supabase project URL from https://supabase.com/dashboard
SUPABASE_URL=your_supabase_project_url_here

# Supabase service role or anon key from https://supabase.com/dashboard
SUPABASE_KEY=your_supabase_key_here

# Local Chroma persistence directory for vector storage
CHROMA_DIR=./chroma_store
